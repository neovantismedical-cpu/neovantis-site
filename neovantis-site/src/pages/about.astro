---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SpecialityIcon from '../components/SpecialityIcon.astro';
import { specialities } from '../config/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }];

// Sentence-case names on this page, for example "Spinal surgery".
const areas = specialities.map((s) => ({ slug: s.slug, name: s.name[0] + s.name.slice(1).toLowerCase(), text: s.card }));---
<BaseLayout
  title="About Neovantis | Specialist Medical Supplier in Umhlanga"
  description="Neovantis is a South African supplier of specialist medical devices, surgical implants, instruments and equipment, based in Umhlanga, Durban."
  breadcrumbs={crumbs}
>
  <img
    class="about-banner"
    src="/images/optimised/about-banner-1280.webp"
    srcset="/images/optimised/about-banner-800.webp 800w, /images/optimised/about-banner-1280.webp 1280w, /images/optimised/about-banner-1942.webp 1942w"
    sizes="100vw"
    width="1942" height="809"
    alt="An open surgical instrument tray and radiofrequency electrodes on a blue drape, blending into the courtyard of an office building"
    fetchpriority="high"
  />

  <div class="page-hero page-hero--dark about-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>About Neovantis</h1>
      <p class="lead">Based in Umhlanga, Durban, Neovantis supplies specialist medical devices, surgical implants, instruments and equipment to healthcare professionals and institutions in South Africa.</p>
    </div>
  </div>

  <section class="section about-section" aria-labelledby="story-heading">
    <div class="container story">
      <h2 id="story-heading">Our story</h2>
      <p>Neovantis was established in 2019 with a focus on orthopaedic trauma, spinal surgery and pain management. Today, our portfolio spans six specialist areas, from surgical fixation and radiofrequency equipment to urology consumables and radiation protection gloves.</p>
    </div>
  </section>

  <section class="section about-section mission-section" aria-labelledby="mission-vision-heading">
    <div class="container">
      <h2 id="mission-vision-heading" class="visually-hidden">Mission and vision</h2>
      <div class="mission-grid">
        <article class="mission-card" aria-labelledby="mission-heading">
          <h3 id="mission-heading">Our mission</h3>
          <p>We equip healthcare teams across South Africa with specialist medical devices, surgical implants, instruments and equipment, backed by practical product and technical support. We take the time to understand what clinicians, theatre teams and procurement professionals need, so they can make informed product choices and prepare for procedures with confidence.</p>
        </article>
        <article class="mission-card" aria-labelledby="vision-heading">
          <h3 id="vision-heading">Our vision</h3>
          <p>We envision a South Africa where advances in medical technology reach more healthcare facilities and benefit more patients. By building lasting relationships with technology partners and the people who deliver care, we aim to help make high-quality specialist care accessible to more communities.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint about-section" aria-labelledby="team-heading">
    <div class="container story">
      <h2 id="team-heading">The expertise behind Neovantis</h2>
      <div class="team-copy">
        <p>Each member of the Neovantis team brings specialist knowledge and practical experience to their role. Our product representatives know the ranges they support in depth, from how implants, instruments and accessories fit together to what theatre and procurement teams need to know before a procedure.</p>
        <p>Surgeons know the procedure they’re planning and may be exploring the Neovantis range for the first time. Tell us what the case calls for, and our product representatives can walk you through the devices, implants and instruments we supply for your speciality and check what’s available for your planned date.</p>
        <p>For a cranial fixation case, for example, the surgeon may want to discuss plate and screw options, the theatre coordinator needs to know which instruments match the system, and procurement needs to confirm what’s included and what to order separately. Our team understands those different needs and can give each person the product information they need to prepare.</p>
        <p>We build on that experience through conversations with clinicians and relationships with our technology partners, so our product knowledge keeps pace with changes in the field and the needs of the teams we support.</p>
      </div>
    </div>
  </section>

  <section class="section about-section" aria-labelledby="areas-heading">
    <div class="container">
      <h2 id="areas-heading" class="about-heading">Our portfolio</h2>
      <ul class="card-grid about-cards">
        {areas.map((a) => (
          <li>
            <article class="spec-card">
              <span class="icon"><SpecialityIcon slug={a.slug} /></span>
              <h3><a href={`/portfolio/${a.slug}/`}>{a.name}</a></h3>
              <p>{a.text}</p>
              <span class="more" aria-hidden="true">View portfolio area →</span>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tint about-section" aria-labelledby="standards-heading">
    <div class="container">
      <h2 id="standards-heading" class="about-heading">Quality and professional standards</h2>
      <p class="measure" style="margin:0">Neovantis holds a SAHPRA medical device establishment licence and ISO certification. It is a member of SAMED and has Level 1 B-BBEE status.</p>
    </div>
  </section>

  <section class="section about-section" aria-labelledby="offices-heading">
    <div class="container">
      <h2 id="offices-heading" class="about-heading">Neovantis offices</h2>
      <div class="offices">
        <img
          src="/images/optimised/neovantis-offices-960.webp"
          srcset="/images/optimised/neovantis-offices-640.webp 640w, /images/optimised/neovantis-offices-960.webp 960w, /images/optimised/neovantis-offices-1280.webp 1280w"
          sizes="(min-width: 900px) 700px, 100vw"
          width="1536" height="1024"
          alt="Neovantis offices, Suite F1, 250 Umhlanga Rocks Drive, Umhlanga, 4051."
          loading="lazy"
        />
        <address>
          <strong>Suite F1</strong><br />
          250 Umhlanga Rocks Drive<br />
          Umhlanga, 4051
        </address>
      </div>
      <p class="about-close"><a class="btn btn-primary" href="/portfolio/">Explore our portfolio</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Natural proportions at every width: the whole image always shows. */
  .about-banner { display: block; width: 100%; height: auto; }

  .about-hero { padding-bottom: clamp(1.5rem, 1.25rem + 1vw, 2.25rem); }
  .about-hero h1 { margin-top: 0.75rem; margin-bottom: 0.5rem; }
  .about-hero .lead { margin: 0; }

  .about-section { padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem); }
  .about-heading { margin-bottom: clamp(1rem, 0.75rem + 1vw, 1.5rem); }

  .story { display: grid; gap: 0.5rem 3rem; }
  .story h2, .story p { margin: 0; }
  .story p { max-width: 68ch; }
  @media (min-width: 900px) { .story { grid-template-columns: 1fr 2.4fr; } }

  /* Continues straight on from "Our story", so no extra gap above. */
  .mission-section { padding-top: 0; }
  .mission-grid { display: grid; gap: 1rem; }
  @media (min-width: 760px) { .mission-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
  .mission-card { background: var(--bg-tint); border: 1px solid var(--line); border-top: 3px solid var(--blue-brand); border-radius: 0 0 var(--radius) var(--radius); padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .mission-card h3 { font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem); margin: 0 0 0.6rem; }
  .mission-card p { margin: 0; }

  .team-copy { max-width: 68ch; }
  .team-copy p { margin: 0 0 1em; }
  .team-copy p:last-child { margin-bottom: 0; }

  /* Phones: icon beside the text, so six stacked cards stay quick to scan. */
  @media (max-width: 639px) {
    .about-cards .spec-card { display: grid; grid-template-columns: 44px 1fr; gap: 0.2rem 0.9rem; padding: 1rem; }
    .about-cards .icon { grid-row: 1 / span 3; margin: 0; }
    .about-cards .more { padding-top: 0.2rem; }
  }

  .offices { display: grid; gap: 1rem 2.5rem; align-items: center; }
  .offices img { width: 100%; height: auto; border-radius: var(--radius); }
  .offices address { font-style: normal; font-size: 1.1em; line-height: 1.6; }
  .offices strong { font-family: var(--font-head); font-size: 1.15em; color: var(--charcoal); }
  @media (min-width: 900px) { .offices { grid-template-columns: minmax(0, 700px) 1fr; } }

  .about-close { margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 0; }
  @media (max-width: 479px) { .about-close .btn { width: 100%; } }
</style>
