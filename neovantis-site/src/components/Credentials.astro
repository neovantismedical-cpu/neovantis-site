---
import { credentials } from '../config/site';
interface Props { tint?: boolean; }
const { tint = true } = Astro.props;
---
<section class:list={['section', { 'section--tint': tint }]} aria-labelledby="credentials-heading">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Credentials</span>
      <h2 id="credentials-heading">Industry membership, licensing and certification</h2>
      <p>Procurement teams can ask our team for supporting documents.</p>
    </div>
    <ul class="cred-grid cred-grid--four">
      {credentials.map((c) => (
        <li class="cred">
          {c.media && (
            <div class="cred-media">
              {c.media.kind === 'image' ? (
                c.media.href ? (
                  <a class="cred-link" href={c.media.href}>
                    {c.media.mark && <img src={c.media.mark.src} width={c.media.mark.width} height={c.media.mark.height} alt={c.media.mark.alt} loading="lazy" decoding="async" />}
                    <img src={c.media.src} width={c.media.width} height={c.media.height} alt={c.media.alt} loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <img
                    class:list={[{ 'cred-media--bordered': c.media.bordered }]}
                    src={c.media.src}
                    width={c.media.width}
                    height={c.media.height}
                    alt={c.media.alt}
                    loading="lazy"
                    decoding="async"
                  />
                )
              ) : (
                <span class="cred-icon">
                  {/* Line icons in the same style as the speciality icons */}
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    {c.media.name === 'document-check' && (<>
                      <path d="M19 3H8a2 2 0 0 0-2 2v22a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V10Z" />
                      <path d="M19 3v7h7" />
                      <path d="m11 19 3.5 3.5L21 16" />
                    </>)}
                    {c.media.name === 'certificate' && (<>
                      <rect x="3" y="5" width="26" height="18" rx="2" />
                      <path d="M8 11h10M8 15h6" opacity=".6" />
                      <circle cx="22.5" cy="16" r="3.5" />
                      <path d="m20.5 19.2-1 7.3 3-1.8 3 1.8-1-7.3" />
                    </>)}
                  </svg>
                </span>
              )}
            </div>
          )}
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
