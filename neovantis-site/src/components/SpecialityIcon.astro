---
// Simple brand line icons. Abstract symbols only; they do not depict specific devices.
interface Props { slug: string; }
const { slug } = Astro.props;
---
<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {slug === 'orthopaedics' && (<>
    <path d="M6 26 26 6" /><path d="M10 28 28 10" opacity=".55" /><circle cx="6" cy="26" r="1.6" fill="currentColor" stroke="none" /><circle cx="26" cy="6" r="1.6" fill="currentColor" stroke="none" />
  </>)}
  {slug === 'spinal-surgery' && (<>
    <rect x="11" y="3" width="10" height="5" rx="2" /><rect x="10" y="10.5" width="12" height="5" rx="2" /><rect x="10" y="18" width="12" height="5" rx="2" /><rect x="11" y="25.5" width="10" height="4" rx="2" />
  </>)}
  {slug === 'neurosurgery' && (<>
    <path d="M16 4c-6.5 0-11 4.6-11 10.5 0 3.6 1.7 6.3 4 8V28h9v-3h3.5a2 2 0 0 0 2-2v-3.5H26l-2.5-4.5C23.5 8.6 20.5 4 16 4Z" /><path d="M12 11h6v6h-6z" opacity=".6" />
  </>)}
  {slug === 'urology' && (<>
    <path d="M16 4c4 5.5 7 9.4 7 13a7 7 0 0 1-14 0c0-3.6 3-7.5 7-13Z" /><path d="M13 18a3 3 0 0 0 3 3" opacity=".6" />
  </>)}
  {slug === 'pain-management' && (<>
    <path d="M3 16h5l3-7 4 14 4-11 3 4h7" />
  </>)}
  {slug === 'radiation-protection' && (<>
    <path d="M10 28v-9l-3-4.5a1.6 1.6 0 0 1 2.6-1.8L12 15V6a1.6 1.6 0 0 1 3.2 0v7-9a1.6 1.6 0 0 1 3.2 0v9-7a1.6 1.6 0 0 1 3.2 0v8-5a1.6 1.6 0 0 1 3.2 0V20c0 4.4-2.6 8-7 8Z" />
  </>)}
  {slug === 'general' && (<>
    <circle cx="16" cy="16" r="11" /><path d="M16 10v6l4 3" />
  </>)}
</svg>
