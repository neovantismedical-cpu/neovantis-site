---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecialityCards from '../../components/SpecialityCards.astro';
import CtaBand from '../../components/CtaBand.astro';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Specialities', href: '/specialities/' }];
---
<BaseLayout
  title="Medical and Surgical Specialities We Supply"
  description="Neovantis supplies specialist products across orthopaedics, spinal surgery, neurosurgery, urology, interventional pain management and radiation protection."
  breadcrumbs={crumbs}
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Our specialities</h1>
      <p class="lead">Neovantis supplies specialist medical devices, surgical implants, instruments and equipment across six portfolio areas. Each speciality page explains what you can enquire about and which details help our team respond.</p>
    </div>
  </div>

  <section class="section" aria-labelledby="list-heading">
    <div class="container">
      <h2 id="list-heading" class="visually-hidden">Speciality areas</h2>
      <SpecialityCards headingLevel="h3" />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="unsure-heading">
    <div class="container two-col">
      <div>
        <h2 id="unsure-heading">Not sure which speciality applies?</h2>
        <p>Send a general enquiry describing the product or procedure area and what you need. Our team will direct it to the right speciality.</p>
      </div>
      <div class="panel">
        <h3>Helpful details for any enquiry</h3>
        <ul class="checklist">
          <li>Product type, specification or system</li>
          <li>Quantity</li>
          <li>The date you are working towards</li>
          <li>Any documentation your facility needs</li>
        </ul>
        <a class="text-link" href="/support/">See the full enquiry checklist →</a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
