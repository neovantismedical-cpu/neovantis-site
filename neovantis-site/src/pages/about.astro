---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SpecialityCards from '../components/SpecialityCards.astro';
import Credentials from '../components/Credentials.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../config/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }];
---
<BaseLayout
  title="About Neovantis | Specialist Medical Supplier in Umhlanga"
  description="Neovantis is a South African supplier of specialist medical devices, surgical implants, instruments and equipment, based in Umhlanga, Durban."
  breadcrumbs={crumbs}
>
  <div class="page-hero page-hero--dark">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>About Neovantis</h1>
      <p class="lead">{business.tagline}.</p>
    </div>
  </div>

  <section class="section" aria-labelledby="who-heading">
    <div class="container two-col two-col--wide-left">
      <div class="measure">
        <h2 id="who-heading">Who we are</h2>
        <p>Neovantis is a South African supplier of specialist medical devices, surgical implants, instruments and equipment for healthcare professionals and institutions.</p>
        <p>We are based in Umhlanga, Durban, in KwaZulu-Natal, and we welcome professional enquiries from across South Africa.</p>
        <p>Neovantis is a supplier. We are not a manufacturer, hospital or clinic, and we do not provide patient treatment or consultations.</p>
      </div>
      <div class="panel panel--tint">
        <h3>Who we supply</h3>
        <ul class="checklist">
          <li>Specialist surgeons and clinicians</li>
          <li>Theatre and cath lab teams</li>
          <li>Hospital procurement and institutional buyers</li>
          <li>Biomedical engineering teams, where equipment is involved</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="areas-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="areas-heading">Our six speciality areas</h2>
        <p>Each speciality page explains what you can enquire about and the details that help our team respond.</p>
      </div>
      <SpecialityCards />
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="container two-col">
      <div class="measure">
        <h2 id="work-heading">How we work with buyers</h2>
        <p>Enquiries start with your requirements: the speciality, the product or system, quantities and the date you are working towards. Our team discusses the relevant product information with you and confirms supply arrangements for each enquiry.</p>
        <p><a class="text-link" href="/support/">Read how enquiries work →</a></p>
      </div>
      <div class="measure">
        <h2>Where to find us</h2>
        <address style="font-style:normal">
          {business.name}<br />{business.address.line1}<br />{business.address.locality}, {business.address.postalCode}<br />{business.address.region}, {business.address.country}
        </address>
        <p style="margin-top:1rem">Telephone: <a href={business.phone.href}>{business.phone.display}</a></p>
      </div>
    </div>
  </section>

  <Credentials />
  <CtaBand />
</BaseLayout>
