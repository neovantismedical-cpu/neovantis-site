---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecialityCards from '../components/SpecialityCards.astro';
import Credentials from '../components/Credentials.astro';
import CtaBand from '../components/CtaBand.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getVisibleInsights } from '../lib/insights';
import { contactHref, leadPortfolio, widerPortfolio } from '../config/site';

// Homepage features these three articles, in this order (only those visible in this build).
const featuredSlugs = ['what-clinical-teams-ask-of-suppliers', 'before-the-case', 'making-repeat-orders-easier'];
const visible = await getVisibleInsights();
const previews = featuredSlugs.map((slug) => visible.find((a) => a.slug === slug)).filter((a) => a !== undefined);
---
<BaseLayout
  title="Specialist Medical Device Supplier in Durban | Neovantis"
  description="Specialist medical device supplier based in Umhlanga, Durban, supplying surgical implants, instruments and equipment to healthcare professionals and institutions."
>
  <section class="hero" aria-labelledby="hero-heading">
    <img
      class="hero-image"
      src="/images/optimised/home-theatre-banner-1280.webp"
      srcset="/images/optimised/home-theatre-banner-800.webp 800w, /images/optimised/home-theatre-banner-1280.webp 1280w, /images/optimised/home-theatre-banner-1920.webp 1920w"
      sizes="(max-width: 899px) 180vw, 100vw"
      width="1920" height="819"
      alt="A theatre team member in navy scrubs and gloves arranging surgical instruments on a stainless steel tray"
      fetchpriority="high"
    />
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-heading">Specialist medical devices for surgical and interventional teams</h1>
        <p class="lead">Based in Umhlanga, Durban, Neovantis supplies surgical implants, instruments and equipment to healthcare professionals and hospitals.</p>
        <a class="btn btn-light" href="#portfolio">Explore our portfolio</a>
      </div>
    </div>
  </section>

  <section class="values-banner" aria-labelledby="values-banner-heading">
    <div class="container">
      <h2 id="values-banner-heading">Improving Lives Together</h2>
      <p>Patient care takes teamwork. Our part is to help clinicians, theatre staff and procurement teams get the specialist devices, instruments and product information they need.</p>
    </div>
  </section>

  <section class="section" id="portfolio" aria-labelledby="portfolio-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="portfolio-heading">Our portfolio</h2>
        <p>We keep up with developments in medical technology through our international partnerships and conversations with surgeons about what their teams need in practice. When we introduce a product, we consider how it fits into the team’s work and what else they’ll need alongside it.</p>
      </div>

      <div class="portfolio-group">
        <div class="portfolio-group-head">
          <h3 id="lead-portfolio-heading">Orthopaedics, spinal surgery and neurosurgery</h3>
          <p>Implants, fixation components and associated instruments for orthopaedic, spinal and neurosurgical teams.</p>
        </div>
        <SpecialityCards
          slugs={leadPortfolio}
          headingLevel="h4"
          notes={{
            'orthopaedics': 'Tell us the K-wire diameter, length, quantity and sterile supply requirements you need to discuss.',
            'spinal-surgery': 'Discuss the fixation components and associated instruments needed for a planned procedure.',
            'neurosurgery': 'Discuss cranial components and matching instrument or tray requirements with our team.',
          }}
        />
        <p style="margin:1.5rem 0 0">Neovantis also provides product introductions and theatre support. Speak to our team about your requirements.</p>
      </div>

      <div class="portfolio-group">
        <div class="portfolio-group-head">
          <h3 id="wider-portfolio-heading">Our wider portfolio</h3>
          <p>Neovantis also supplies urology devices, radiofrequency equipment for interventional pain management and radiation protection gloves. Each area has its own page.</p>
        </div>
        <SpecialityCards slugs={widerPortfolio} headingLevel="h4" compact />
      </div>

      <p class="portfolio-more"><a class="btn btn-primary" href="/portfolio/">View the full portfolio</a></p>
    </div>
  </section>

  <div class="section section--tint">
    <div class="container">
      <section class="panel theatre-support" aria-labelledby="theatre-support-heading">
        <h2 id="theatre-support-heading">Product introductions and theatre support</h2>
        <p>Meet with a Neovantis product representative to explore the devices, implants and instruments available in your speciality and discuss what your team needs.</p>
        <p>For selected cases, our team can attend theatre to provide technical product support. Hospital purchasing teams can contact us for quotes, product information and help with supply enquiries.</p>
        <div class="btn-row" style="align-items:center;gap:0.75rem 1.5rem">
          <a class="btn btn-primary" href={contactHref(undefined, 'meeting')}>Request a meeting</a>
          <a class="text-link" href="/support/">View product and theatre support →</a>
        </div>
      </section>
    </div>
  </div>

  <section class="section" aria-labelledby="plan-heading">
    <div class="container">
      <div class="two-col two-col--wide-left" style="margin-bottom:2.5rem">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">How we help</span>
          <h2 id="plan-heading">From product enquiry to supply</h2>
        </div>
        <div>
          <p style="margin:0">Preparing for a procedure, evaluating equipment or replenishing stock? Tell us what your team needs and we’ll walk you through the relevant options in the Neovantis range.</p>
        </div>
      </div>
      <ol class="steps">
        <li>
          <h3>Tell us what you need</h3>
          <p>Share your speciality and what you’re preparing for or sourcing. If you already know the product, specification or system, include it along with any quantities or dates you’re working towards.</p>
        </li>
        <li>
          <h3>Explore the product options</h3>
          <p>Our team can explain what we supply, check which instruments or accessories are compatible, and tell you what product documentation is available.</p>
        </li>
        <li>
          <h3>Confirm availability and supply</h3>
          <p>When you’re ready to order, we’ll confirm availability and discuss quantities, timing and delivery arrangements with you.</p>
        </li>
      </ol>
      <ul class="btn-row" style="list-style:none;padding:0;margin:1.5rem 0 0;gap:0.5rem 2rem">
        <li><a class="text-link" href="/support/">What to include in your enquiry →</a></li>
        <li><a class="text-link" href="/support/#faq">Frequently asked questions →</a></li>
      </ul>
    </div>
  </section>

  <Credentials />

  {previews.length > 0 && (
    <section class="section" aria-labelledby="insights-heading">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Insights</span>
          <h2 id="insights-heading">Professional insights</h2>
          <p>Practical guidance on preparing supply and procurement enquiries.</p>
        </div>
        <ul class="article-grid featured-insights">
          {previews.map((a) => <li><ArticleCard article={a} /></li>)}
        </ul>
        <p class="featured-insights-more"><a class="text-link" href="/insights/">View all insights →</a></p>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  .values-banner { background: var(--charcoal); color: #fff; text-align: center; padding-block: clamp(2rem, 1.5rem + 2vw, 3rem); border-top: 1px solid rgba(255,255,255,0.08); }
  .values-banner .container { max-width: 62ch; padding-inline: max(var(--gutter, 1rem), 1.25rem); }
  .values-banner h2 { color: #fff; font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); margin: 0 0 0.6rem; }
  .values-banner p { margin: 0; font-size: 1.08rem; color: #fff; }

  /* Three cards: stacked on smaller screens, one row on desktop. */
  .featured-insights { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .featured-insights { grid-template-columns: repeat(3, 1fr); } }
  .featured-insights-more { margin: 1.5rem 0 0; }

  .portfolio-more { margin: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem) 0 0; }
  .theatre-support { margin-top: 0; border-top: 3px solid var(--blue-brand); border-radius: 0 0 var(--radius) var(--radius); }
  .theatre-support h2 { font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem); margin: 0 0 0.6rem; }
  .theatre-support p { max-width: 68ch; margin: 0 0 0.75rem; }
  .theatre-support p:last-of-type { margin-bottom: 1.25rem; }

  /* Portfolio group introductions: subtle brand panels so the headings stand out. */
  #portfolio .portfolio-group-head {
    max-width: none;
    background: var(--bg-tint-2);
    border: 1px solid var(--line);
    border-left: 4px solid var(--blue-brand);
    border-radius: var(--radius-sm);
    padding: 1.1rem 1.35rem;
    margin-bottom: 1.5rem;
  }
  #portfolio .portfolio-group-head h3 { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem); color: var(--charcoal); margin-bottom: 0.4rem; }
  #portfolio .portfolio-group-head p { max-width: 70ch; color: var(--text); }
  #portfolio .portfolio-group + .portfolio-group .portfolio-group-head { background: var(--bg-tint); border-left-color: var(--blue-accent); }
</style>
