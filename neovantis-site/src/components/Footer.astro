---
import { business, specialities, contactHref } from '../config/site';
import { insightsLinksVisible } from '../lib/insights';
const showInsights = await insightsLinksVisible();
const a = business.address;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand-lockup">
          <img src={business.logoMark} width="461" height="154" alt="Neovantis" loading="lazy" decoding="async" />
          <span class="brand-tagline">{business.tagline}</span>
        </div>
        <p>Specialist medical devices, surgical implants, instruments and equipment for healthcare professionals and institutions.</p>
        <p class="footer-note">This website is for professional supply enquiries. It does not provide patient consultations or medical advice.</p>
      </div>

      <div>
        <h2>Specialities</h2>
        <ul>
          {specialities.map((s) => <li><a href={`/specialities/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/specialities/">All specialities</a></li>
          <li><a href="/support/">Support</a></li>
          {showInsights && <li><a href="/insights/">Insights</a></li>}
          <li><a href={contactHref()}>Contact</a></li>
        </ul>
      </div>

      <div>
        <h2>Contact</h2>
        <address>
          {business.name}<br />
          {a.line1}<br />
          {a.locality}, {a.postalCode}<br />
          {a.region}, {a.country}
        </address>
        <ul>
          <li>Telephone: <a href={business.phone.href}>{business.phone.display}</a></li>
          <li>Email: <a href={`mailto:${business.email}`}>{business.email}</a></li>
        </ul>
        <div class="footer-social">
          <h3 id="footer-social-heading">Follow Neovantis</h3>
          <ul aria-labelledby="footer-social-heading">
            {business.social.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.icon === 'linkedin' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>}
                  {s.icon === 'youtube' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>}
                  {s.icon === 'instagram' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.25"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg>}
                  <span>{s.name}</span><span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {business.name}. {business.tagline}.</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms of use</a></li>
        <li><a href="/medical-disclaimer/">Medical disclaimer</a></li>
      </ul>
    </div>
  </div>
</footer>
