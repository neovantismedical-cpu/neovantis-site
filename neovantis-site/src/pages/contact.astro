---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { business } from '../config/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }];
const a = business.address;
---
<BaseLayout
  title="Contact Neovantis in Umhlanga, Durban"
  description="Contact Neovantis at Suite F1, 250 Umhlanga Rocks Drive, Umhlanga. Call 031 463 1188 or send a professional supply enquiry about specialist medical devices."
  breadcrumbs={crumbs}
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Speak to the Neovantis team.</h1>
      <p class="lead">Get in touch to discuss product options for your speciality, request a quote or arrange a meeting with a Neovantis representative. We welcome enquiries from healthcare professionals and procurement teams across South Africa.</p>
      <div class="notice measure" style="margin-top:1rem">
        <p>This website does not provide patient consultations or medical advice. If you are a patient, please speak to your healthcare provider.</p>
      </div>
    </div>
  </div>

  <section class="section" aria-label="Contact details and enquiry form">
    <div class="container">
      <div class="contact-grid">
        <div>
          <h2>Contact details</h2>
          <ul class="contact-list">
            <li>
              <h3>Telephone</h3>
              <p><a href={business.phone.href}>{business.phone.display}</a></p>
            </li>
            <li>
              <h3>Email</h3>
              <p><a href={`mailto:${business.email}`}>{business.email}</a></p>
            </li>
            <li>
              <h3>Address</h3>
              <address>
                {business.name}<br />
                {a.line1}<br />
                {a.locality}, {a.postalCode}<br />
                {a.region}, {a.country}
              </address>
            </li>
          </ul>

          <div class="panel panel--tint" style="margin-top:2rem">
            <h3>Helpful details to include</h3>
            <ul class="checklist">
              <li>The speciality and product, specification or system</li>
              <li>Quantity and the date you are working towards</li>
              <li>Any documentation your facility needs</li>
            </ul>
            <a class="text-link" href="/support/">More on preparing an enquiry →</a>
          </div>
        </div>
        <EnquiryForm />
      </div>
    </div>
  </section>
</BaseLayout>
