---
interface Props { links: { label: string; href: string }[] }
const { links } = Astro.props;
---
<nav class="related-reading" aria-labelledby="related-reading-heading">
  <h3 id="related-reading-heading">Related reading</h3>
  <ul>
    {links.map((r) => <li><a class="text-link" href={r.href}>{r.label} →</a></li>)}
  </ul>
</nav>

<style>
  .related-reading { margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .related-reading h3 { font-size: 1.1rem; margin: 0 0 0.5rem; }
  .related-reading ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
</style>
