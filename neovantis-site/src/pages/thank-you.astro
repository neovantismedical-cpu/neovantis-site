---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../config/site';
---
<BaseLayout title="Enquiry received" description="Thank you for contacting Neovantis." noindex>
  <section class="section">
    <div class="container measure">
      <h1>Thank you. Your enquiry has been sent.</h1>
      <p class="lead">The Neovantis team has received your enquiry and will be in touch using the contact details you provided.</p>
      <p>If your enquiry is time-sensitive, please call <a href={business.phone.href}>{business.phone.display}</a>.</p>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn btn-primary" href="/portfolio/">Back to our portfolio</a>
        <a class="btn btn-secondary" href="/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
