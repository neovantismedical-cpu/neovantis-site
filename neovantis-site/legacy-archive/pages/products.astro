---
import MainLayout from '../layouts/MainLayout.astro';

const families = [
  {
    num: '01',
    title: 'Orthopaedic Trauma Solutions',
    summary: 'Our orthopaedic trauma portfolio is designed to support fixation, structural stability, and dependable surgical performance across a broad range of trauma applications — from plating and fixation systems to supporting instrumentation.',
    bullets: [
      'Trauma fixation and support solutions',
      'Plating and fixation solution categories',
      'K-wire and supporting fixation system areas',
      'Complementary surgical instrumentation',
    ],
    image: '/images/neovantis-orthopaedic-trauma-plate.png',
    href: '/orthopaedic-trauma',
  },
  {
    num: '02',
    title: 'RF Ablation & Pain Management',
    summary: 'Our RF ablation and pain management portfolio supports clinicians in delivering targeted, minimally invasive treatments in specialist care settings — including generator and procedure-support solution areas developed for precision and workflow efficiency.',
    bullets: [
      'RF generator and control unit solutions',
      'Electrode and cannula solution families',
      'Procedure accessory and kit categories',
      'Designed for procedural precision and efficiency',
    ],
    image: '/images/neovantis-rf-ablation-technology.png',
    href: '/rf-ablation-pain-management',
  },
  {
    num: '03',
    title: 'Neuro Plating Systems',
    summary: 'Our Neuro Plating Systems support specialist cranial fixation and reconstruction requirements through a focused portfolio designed around precision, structural reliability, and clinically appropriate design considerations.',
    bullets: [
      'Cranial fixation and reconstruction focus',
      'Anatomical and low-profile design direction',
      'Biocompatibility and imaging-compatible positioning',
      'Supports specialist neurosurgical applications',
    ],
    image: '/images/innovations-in-orthopaedic-technology.png',
    href: '/neuro-plating',
  },
  {
    num: '04',
    title: 'Urology Solutions',
    summary: 'Our urology solutions are developed to support efficient intervention, clinician confidence, and patient-focused care across a wide range of procedural and ward-based requirements.',
    bullets: [
      'Access and dilation support solutions',
      'Drainage and catheter-related solution families',
      'Stent, guidewire, and retrieval-related categories',
      'Designed for practical clinical use',
    ],
    image: '/images/neovantis-precision-pain-management.png',
    href: '/urology-solutions',
  },
  {
    num: '05',
    title: 'Radiation Protection Gloves',
    summary: 'Our radiation protection glove category supports clinicians and teams working in interventional and imaging-driven environments, combining protective intent with practical comfort and procedure usability.',
    bullets: [
      'Protection-oriented clinical positioning',
      'Comfort and grip-focused usability',
      'Suitable for specialist high-exposure environments',
      'Supports interventional and imaging procedure settings',
    ],
    image: '/images/neovantis-healthcare-professionals.png',
    href: '/radiation-protection-gloves',
  },
];
---

<MainLayout
  title="Products | Neovantis"
  description="Neovantis product families span orthopaedic trauma, RF ablation pain management, neuro plating, urology, and radiation protection. Contact our team for full product information and brochure requests."
>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-bg" style="background-image:url('/images/products banner hero.png')"></div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="page-hero-content">
        <p style="font-family:var(--font-display);font-size:0.8rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--blue-accent);margin-bottom:0.5rem;">Our Portfolio</p>
        <h1>Products</h1>
        <div class="accent-bar" style="margin-left:auto;"></div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section section--sm">
    <div class="container">
      <div class="section-heading">
        <h2>Our Product Portfolio</h2>
        <div class="section-divider"></div>
        <p>Our product portfolio is structured around specialist clinical categories designed to support healthcare professionals with trusted, high-quality medical solutions. For detailed product information and full range documentation, please contact our team or request a brochure.</p>
      </div>
      <!-- Category nav -->
      <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-top:1rem;">
        {families.map(f => (
          <a href={`#family-${f.num}`} class="btn btn-ghost" style="font-size:0.8rem;padding:0.6rem 1.25rem;">{f.title}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Family Sections -->
  {families.map((fam, i) => (
    <section
      id={`family-${fam.num}`}
      class="section section--lg"
      style={i % 2 !== 0 ? 'background:var(--bg-secondary);' : ''}
    >
      <div class="container">
        <div class="grid-2" style={`align-items:center;gap:4rem;${i % 2 !== 0 ? 'direction:rtl;' : ''}`}>
          <div style={i % 2 !== 0 ? 'direction:ltr;' : ''}>
            <p style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--blue-accent);margin-bottom:0.5rem;">Product Family {fam.num}</p>
            <h2 style="margin-bottom:1rem;">{fam.title}</h2>
            <div class="section-divider" style="margin-left:0;width:60px;"></div>
            <p style="margin-bottom:1.5rem;">{fam.summary}</p>
            <ul style="list-style:none;margin-bottom:2rem;">
              {fam.bullets.map(b => (
                <li style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem;color:var(--text-muted);font-family:var(--font-prose);">
                  <span style="color:var(--blue-primary);font-size:1rem;">✓</span> {b}
                </li>
              ))}
            </ul>
            <div style="display:flex;gap:1rem;flex-wrap:wrap;">
              <a href="/contact" class="btn btn-primary">Request Full Product Brochure</a>
              <a href={fam.href} class="btn btn-ghost">Learn More</a>
            </div>
          </div>
          <div style={`border-radius:8px;overflow:hidden;border:1px solid rgba(31,127,182,0.3);${i % 2 !== 0 ? 'direction:ltr;' : ''}`}>
            <img
              src={fam.image}
              alt={fam.title}
              style="width:100%;height:340px;object-fit:cover;display:block;filter:brightness(0.93) saturate(0.88);"
            />
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Brochure Request Note -->
  <section class="section section--sm" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="alert" style="max-width:820px;margin:0 auto;text-align:center;font-size:0.95rem;padding:1.5rem 2rem;">
        For detailed product specifications, full range documentation, SAHPRA registration information, and clinical data sheets, please contact the Neovantis team directly. Our clinical support team will respond to all enquiries within one business day.
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-banner">
    <div class="container" style="position:relative;z-index:1;">
      <h2>Request Clinical Product Information</h2>
      <p>Contact our team for detailed product documentation, brochure requests, or to discuss a specific clinical or procurement requirement.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-outline">Request a Brochure</a>
        <a href="/healthcare-professionals" class="btn btn-primary" style="background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.5);">Healthcare Professionals</a>
      </div>
    </div>
  </div>

</MainLayout>
