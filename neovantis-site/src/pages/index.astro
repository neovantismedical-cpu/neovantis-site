---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecialityCards from '../components/SpecialityCards.astro';
import Credentials from '../components/Credentials.astro';
import CtaBand from '../components/CtaBand.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { business, contactHref } from '../config/site';
import { getVisibleInsights } from '../lib/insights';

const previews = (await getVisibleInsights()).slice(0, 2);
---
<BaseLayout
  title="Specialist Medical Device Supplier in Durban | Neovantis"
  description="Specialist medical device supplier based in Umhlanga, Durban, supplying surgical implants, instruments and equipment to healthcare professionals and institutions."
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Specialist medical supply | South Africa</span>
        <h1 id="hero-heading">Specialist medical and surgical solutions.</h1>
        <p class="tagline">{business.tagline}</p>
        <p class="lead">Based in Umhlanga, Durban, Neovantis supplies specialist medical devices, surgical implants, instruments and equipment to healthcare professionals and institutions. Explore our six portfolio areas or contact our team about your requirements.</p>
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn btn-light" href="/specialities/">Explore our specialities</a>
          <a class="btn btn-ghost-light" href={contactHref()}>Speak to our team</a>
        </div>
      </div>

      <div class="hero-visual">
        <figure class="hv-main">
          <img
            src="/images/optimised/k-wire-tray-illustration-960.webp"
            srcset="/images/optimised/k-wire-tray-illustration-640.webp 640w, /images/optimised/k-wire-tray-illustration-960.webp 960w, /images/optimised/k-wire-tray-illustration-1280.webp 1280w"
            sizes="(min-width: 1200px) 560px, (min-width: 960px) 46vw, 92vw"
            width="960" height="640"
            alt="Illustration of wires and pins arranged in an instrument tray"
            fetchpriority="high" decoding="async"
          />
        </figure>
        <figure class="hv-small">
          <img
            src="/images/optimised/rf-electrodes-illustration-480.webp"
            width="480" height="480"
            alt="Illustration of radiofrequency electrodes on a sterile drape"
            decoding="async"
          />
        </figure>
        <div class="hv-tile">
          <strong>Six specialist portfolio areas</strong>
          <span>From orthopaedics to radiation protection</span>
        </div>
        <p class="figure-note">Illustrative images, not photographs of specific Neovantis products.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="specialities-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our specialities</span>
        <h2 id="specialities-heading">Six portfolio areas for specialist teams</h2>
        <p>Choose a speciality to see what you can enquire about and the details that help our team respond.</p>
      </div>
      <SpecialityCards />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="plan-heading">
    <div class="container">
      <div class="two-col two-col--wide-left" style="margin-bottom:2.5rem">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">How we help</span>
          <h2 id="plan-heading">The information clinical teams need to plan</h2>
        </div>
        <div>
          <p>Start with the relevant speciality page to see the products you can enquire about. From there, you can request product and compatibility information, ask about instruments and documentation, and discuss quantities and timing for your case or stock cycle.</p>
          <p style="margin:0">Availability and supply arrangements are confirmed with our team for each enquiry.</p>
        </div>
      </div>
      <ol class="steps">
        <li>
          <h3>Tell us the speciality and your requirements</h3>
          <p>Include the product, specification or system, quantity and the date you are working towards.</p>
        </li>
        <li>
          <h3>Discuss the relevant product information</h3>
          <p>Our team discusses specifications, compatibility and any documentation your facility needs.</p>
        </li>
        <li>
          <h3>Confirm supply arrangements with the team</h3>
          <p>Agree quantities, timing and how the order will be supplied.</p>
        </li>
      </ol>
      <p style="margin-top:1.5rem"><a class="text-link" href="/support/">What to include in your enquiry →</a></p>
    </div>
  </section>

  <Credentials tint={false} />

  {previews.length > 0 && (
    <section class="section section--tint" aria-labelledby="insights-heading">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Insights</span>
          <h2 id="insights-heading">Professional insights</h2>
          <p>Practical guidance on preparing supply and procurement enquiries.</p>
        </div>
        <ul class="article-grid">
          {previews.map((a) => <li><ArticleCard article={a} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
