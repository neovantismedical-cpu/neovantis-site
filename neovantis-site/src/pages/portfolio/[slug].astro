---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecialityCards from '../../components/SpecialityCards.astro';
import SpecialityIcon from '../../components/SpecialityIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import RelatedReading from '../../components/RelatedReading.astro';
import { specialities, contactHref, type Speciality } from '../../config/site';

export function getStaticPaths() {
  return specialities.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Speciality };
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Portfolio', href: '/portfolio/' },
  { name: s.name, href: `/portfolio/${s.slug}/` },
];
// Related reading goes at the end of the last content section: the enquiry section, the enquiry cards, or the options section.
const relatedIn = !s.related?.length ? null : s.enquiry ? 'enquiry' : s.sections.length > 0 ? 'details' : s.options ? 'options' : null;
---
<BaseLayout title={s.metaTitle} description={s.metaDescription} breadcrumbs={crumbs}>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class:list={['page-hero-grid', 'has-media']}>
        <div>
          <span class="eyebrow" style="margin-top:1.25rem">{s.name}</span>
          <h1 style="margin-top:0">{s.h1}</h1>
          <div class="measure">
            <p class="lead">{s.intro[0]}</p>
            {s.intro[1] && <p>{s.intro[1]}</p>}
          </div>
          <div class="btn-row" style="margin-top:1.5rem">
            <a class="btn btn-primary" href={contactHref(s.slug)} data-track-speciality={s.slug}>{s.button}</a>
            {s.secondaryLink && <a class="btn btn-secondary" href={s.secondaryLink.href} data-track-speciality={s.slug}>{s.secondaryLink.label}</a>}
          </div>
        </div>
        {s.image ? (
          <figure class="page-hero-media">
            <img src={s.image.src} srcset={s.image.srcset} sizes="(min-width: 900px) 40vw, 92vw" width={s.image.width} height={s.image.height} alt={s.image.alt} fetchpriority="high" decoding="async" />
            {s.image.caption && <figcaption>{s.image.caption}</figcaption>}
          </figure>
        ) : (
          <div class="speciality-mark" aria-hidden="true"><SpecialityIcon slug={s.slug} /></div>
        )}
      </div>
    </div>
  </div>

  {s.explainer && (
    <section class="section compact explainer" aria-labelledby="explainer-heading">
      <div class="container">
        <h2 id="explainer-heading" class="compact-heading">{s.explainer.heading}</h2>
        <div class="measure">
          {s.explainer.text.map((t) => <p>{t}</p>)}
          {s.explainer.subsections?.map((sub) => (
            <div class="explainer-sub">
              <h3>{sub.heading}</h3>
              {sub.paras.map((p) => <p>{p.lead && <strong>{p.lead}</strong>}{p.lead && ' '}{p.text}</p>)}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {s.options ? (
    <section class="section compact" aria-labelledby="options-heading">
      <div class="container">
        <h2 id="options-heading" class="compact-heading">{s.options.heading}</h2>
        <div class="measure">
          {s.options.text.map((t) => <p>{t}</p>)}
        </div>
        {s.options.paras && (
          <div class="measure options-paras">
            {s.options.paras.map((p) => <p><strong>{p.lead}</strong> {p.text}</p>)}
          </div>
        )}
        {s.options.blocks?.map((b, i) => (
          <div class="options-block">
            <h2 id={`options-block-${i + 1}`} class="compact-heading">{b.heading}</h2>
            <div class="measure">{b.text.map((t) => <p>{t}</p>)}</div>
          </div>
        ))}
        {s.options.button !== false && (
          <div class="btn-row" style="margin-top:1.75rem">
            <a class="btn btn-primary" href={contactHref(s.slug)} data-track-speciality={s.slug}>{s.button}</a>
          </div>
        )}
        {relatedIn === 'options' && <RelatedReading links={s.related!} />}
      </div>
    </section>
  ) : (
    <section class="section compact" aria-labelledby="range-heading">
      <div class="container">
        <h2 id="range-heading" class="compact-heading">{s.rangeHeading ?? 'What Neovantis supplies'}</h2>
        <div class="range">
          {s.range.map((group) => (
            <div class="range-group" style={`flex-grow:${group.items.length}`}>
              {group.heading && <h3>{group.heading}</h3>}
              <ul class="range-items">
                {group.items.map((item) => (
                  <li class="range-item"><strong>{item.name}</strong><p>{item.text}</p></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {s.guide && (
  <section class="section section--tint compact" aria-labelledby="guide-heading">
    <div class="container">
      <h2 id="guide-heading" class="compact-heading">{s.guide.heading}</h2>
      <div class="measure">
        {s.guide.text.map((t) => <p>{t}</p>)}
      </div>
      {s.guide.points && (
        <ul class="guide-points">
          {s.guide.points.map((p) => (
            <li class="guide-point"><h3>{p.name}</h3><p>{p.text}</p></li>
          ))}
        </ul>
      )}
      {s.guide.close && <p class="measure guide-close">{s.guide.close}</p>}
    </div>
  </section>
  )}

  {s.enquiry && (
    <section class="section compact enquiry" aria-labelledby="enquiry-heading">
      <div class="container">
        <h2 id="enquiry-heading" class="compact-heading">{s.enquiry.heading}</h2>
        <div class="measure options-paras">
          {s.enquiry.paras.map((p) => <p><strong>{p.lead}</strong> {p.text}</p>)}
          <p>Need product information or technical documentation for evaluation or procurement? Say so in your enquiry and our team will tell you what can be provided. Questions about how we handle enquiries? See <a href="/support/">Support</a>.</p>
        </div>
        {s.enquiry.note && <div class="notice measure enquiry-note"><p>{s.enquiry.note}</p></div>}
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn btn-primary" href={contactHref(s.slug)} data-track-speciality={s.slug}>{s.button}</a>
        </div>
        {relatedIn === 'enquiry' && <RelatedReading links={s.related!} />}
      </div>
    </section>
  )}

  {s.sections.length > 0 && (
  <section class="section" aria-labelledby="details-heading">
    <div class="container">
      <h2 id="details-heading" class="visually-hidden">Preparing your enquiry</h2>
      <div class="two-col">
        {s.sections.map((sec) => (
          <div class="panel panel--tint">
            <h3>{sec.heading}</h3>
            {sec.intro && <p>{sec.intro}</p>}
            {sec.items && <ul class="checklist">{sec.items.map((i) => <li>{i}</li>)}</ul>}
            {sec.note && <div class="notice"><p>{sec.note}</p></div>}
          </div>
        ))}
        <div class="panel">
          <h3>Requesting documentation</h3>
          <p>If your facility needs product information or technical documentation for evaluation or procurement, say so in your enquiry and our team will tell you what can be provided.</p>
          <p style="margin:0">Questions about how we handle enquiries? See <a href="/support/">Support</a>.</p>
        </div>
      </div>
      {relatedIn === 'details' && <RelatedReading links={s.related!} />}
    </div>
  </section>
  )}

  <section class="section section--tint" aria-labelledby="other-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="other-heading">More from our portfolio</h2>
      </div>
      <SpecialityCards exclude={s.slug} />
    </div>
  </section>

  <CtaBand
    heading="Discuss your next supply requirement"
    text={`Send us your ${s.name.toLowerCase()} enquiry and our team will discuss the relevant product information and supply arrangements.`}
    speciality={s.slug}
    buttonLabel={s.button}
  />
</BaseLayout>

<style>
  .compact { padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem); }
  .compact-heading { margin-bottom: clamp(0.75rem, 0.5rem + 1vw, 1.25rem); }
  /* A divider keeps the explainer distinct from the white range section that follows. */
  .explainer { border-bottom: 1px solid var(--line); }
  .explainer-sub { margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .explainer-sub h3 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .explainer-sub strong { color: var(--charcoal); }

  .range { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .range-group { flex: 1 1 260px; min-width: 0; }
  .range-group h3 { font-size: 1.15rem; margin: 0 0 0.6rem; }
  .range-items { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); list-style: none; padding: 0; margin: 0; }
  .range-item { padding: 1rem 1.1rem; border: 1px solid var(--line); border-top: 3px solid var(--blue-brand); border-radius: 0 0 var(--radius) var(--radius); }
  .range-item strong { font-family: var(--font-head); color: var(--charcoal); font-size: 1.08rem; line-height: 1.3; }
  .range-item p { margin: 0.3rem 0 0; color: var(--muted); }

  .options-paras { margin-top: 1rem; }
  .options-paras strong { color: var(--charcoal); }
  /* Divider keeps the enquiry section distinct from the white range section above. */
  .enquiry { border-top: 1px solid var(--line); }
  .enquiry-note { margin-top: 1.25rem; }
  /* Practical ordering blocks (Orthopaedics): brand panels so they stand out below the introduction. */
  .options-block { margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem); max-width: 78ch; padding: 1.15rem 1.35rem; background: var(--bg-tint-2); border: 1px solid var(--line); border-left: 4px solid var(--blue-brand); border-radius: var(--radius-sm); }
  .options-block h2 { font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem); margin-bottom: 0.5rem; }

  .guide-points { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); list-style: none; padding: 0; margin: 1.25rem 0 0; }
  .guide-point { padding: 1.1rem 1.25rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .guide-point h3 { font-size: 1.15rem; margin: 0 0 0.35rem; }
  .guide-point p { margin: 0; color: var(--muted); }
  .guide-close { margin: 1.25rem 0 0; }
  .measure p:last-child { margin-bottom: 0; }
</style>
