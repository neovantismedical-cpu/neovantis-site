---
import { business, specialities, contactHref } from '../config/site';
import { insightsLinksVisible } from '../lib/insights';
const showInsights = await insightsLinksVisible();
const a = business.address;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand-lockup">
          <img src={business.logoMark} width="461" height="154" alt="Neovantis" loading="lazy" decoding="async" />
          <span class="brand-tagline">{business.tagline}</span>
        </div>
        <p>Specialist medical devices, surgical implants, instruments and equipment for healthcare professionals and institutions.</p>
        <p class="footer-note">This website is for professional supply enquiries. It does not provide patient consultations or medical advice.</p>
      </div>

      <div>
        <h2>Specialities</h2>
        <ul>
          {specialities.map((s) => <li><a href={`/specialities/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/specialities/">All specialities</a></li>
          <li><a href="/support/">Support</a></li>
          {showInsights && <li><a href="/insights/">Insights</a></li>}
          <li><a href={contactHref()}>Contact</a></li>
        </ul>
      </div>

      <div>
        <h2>Contact</h2>
        <address>
          {business.name}<br />
          {a.line1}<br />
          {a.locality}, {a.postalCode}<br />
          {a.region}, {a.country}
        </address>
        <ul>
          <li>Telephone: <a href={business.phone.href}>{business.phone.display}</a></li>
          <li>Email: <a href={`mailto:${business.email}`}>{business.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {business.name}. {business.tagline}.</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms of use</a></li>
        <li><a href="/medical-disclaimer/">Medical disclaimer</a></li>
      </ul>
    </div>
  </div>
</footer>
